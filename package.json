{
	"name": "workcalendar",
	"private": true,
	"version": "1.0.0",
	"description": "Производственный календарь России, Казахстана, Беларуси, Армении и Украины с наложением стран и расчётом отпуска",
	"license": "MIT",
	"author": "Misha Saidov (https://cv.mishasaidov.com/)",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings=0 && prettier --check .",
		"lint:fix": "eslint . --fix && prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:dist": "vitest run --config vitest.dist.config.ts",
		"size-limit": "size-limit",
		"og": "tsx scripts/og.ts",
		"goals": "tsx scripts/goals.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"@preact/signals": "^2.11.4",
		"preact": "^11.2.0",
		"preact-render-to-string": "^6.8.2"
	},
	"devDependencies": {
		"@babel/core": "^7.29.13",
		"@eslint/js": "^10.0.1",
		"@fontsource/noto-sans": "^5.3.0",
		"@fontsource/noto-sans-armenian": "^5.3.0",
		"@preact/preset-vite": "^2.10.6",
		"@resvg/resvg-js": "^2.6.2",
		"@size-limit/file": "^14.3.0",
		"@testing-library/preact": "^3.2.6",
		"@types/node": "^22.20.5",
		"eslint": "^10.14.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.10.0",
		"satori": "^0.63.2",
		"size-limit": "^14.3.0",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
